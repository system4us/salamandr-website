---
import { SITE } from '../consts';
import BlotchMark from './BlotchMark.astro';

const nav = [
  { href: SITE.contextRailUrl, label: 'Context Rail' },
  { href: SITE.editionsUrl, label: 'Editions' },
  { href: SITE.compareUrl, label: 'Compare' },
  { href: SITE.industriesUrl, label: 'Industries' },
  { href: SITE.apiReferenceUrl, label: 'API' },
  { href: SITE.docsUrl, label: 'Docs' }
];
---

<header class="sticky top-0 z-50 border-b border-bone-dim/20 bg-ink/85 backdrop-blur-md transition-all">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href={SITE.homeUrl} class="group flex items-center gap-2.5 font-display text-xl font-semibold tracking-tight text-paper">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-ember/30 bg-ember/10 transition-colors group-hover:border-ember/60">
        <BlotchMark class="h-4.5 w-4.5 text-ember" />
      </div>
      <span class="transition-colors group-hover:text-ember">{SITE.name}</span>
    </a>
    <nav class="hidden items-center gap-8 font-mono text-xs uppercase tracking-wider text-bone-dim md:flex">
      {nav.map((item) => (
        <a href={item.href} class="relative py-1 text-bone transition-colors hover:text-ember">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-4">
      <a
        href={SITE.githubUrl}
        class="hidden font-mono text-xs uppercase tracking-wider text-bone-dim transition-colors hover:text-paper sm:inline-flex"
      >
        GitHub
      </a>
      <a
        href={SITE.quickstartUrl}
        class="relative inline-flex items-center justify-center overflow-hidden rounded-md border border-ember/80 bg-ember px-4 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-ink shadow-[0_0_20px_rgba(232,137,11,0.25)] transition-all hover:bg-ember/90 hover:shadow-[0_0_25px_rgba(232,137,11,0.45)]"
      >
        Get started
      </a>
    </div>
  </div>
</header>
