---
import { getCollection } from 'astro:content';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { SITE } from '../../consts';

const entries = (await getCollection('comparisons')).sort((a, b) => a.data.order - b.data.order);
---

<MarketingLayout
  title="Compare Salamandr to other helpdesks"
  description="How Salamandr compares to Zendesk, Freshdesk, Intercom and Help Scout on self-hosting, data custody, pricing and channel coverage."
>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-ember">Comparisons</p>
    <h1 class="mt-3 max-w-2xl font-display text-4xl font-semibold tracking-tight text-paper">Compare Salamandr</h1>
    <p class="mt-4 max-w-2xl text-bone">
      Every one of these tools is a capable helpdesk. The difference that doesn't show up in a feature table is
      who ends up holding your ticket data — pick the comparison closest to what you're evaluating.
    </p>

    <div class="mt-14 grid gap-px border border-bone-dim/20 bg-bone-dim/20 sm:grid-cols-2">
      {entries.map((entry) => (
        <a
          href={`${SITE.compareUrl}${entry.id}/`}
          class="group flex flex-col bg-ink p-8 transition-colors hover:bg-ink-raised"
        >
          <h2 class="font-display text-xl font-semibold text-paper group-hover:text-ember">
            Salamandr vs {entry.data.competitor}
          </h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-bone">{entry.data.cardBlurb}</p>
          <span class="mt-6 font-mono text-xs uppercase tracking-wider text-ember">Read the comparison &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</MarketingLayout>
