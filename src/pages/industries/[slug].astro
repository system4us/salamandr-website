---
import { getCollection, render } from 'astro:content';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('industries');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<MarketingLayout title={`${data.name} — Salamandr`} description={data.painPoint}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden border-b border-bone-dim/20 pb-16 pt-16 sm:pb-20 sm:pt-20">
    <div class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 h-[450px] w-full max-w-7xl bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(232,137,11,0.12),transparent_70%)]"></div>

    <div class="mx-auto max-w-4xl px-6">
      <div class="flex items-center gap-2 mb-6">
        <a href={SITE.industriesUrl} class="font-mono text-xs text-bone-dim hover:text-ember transition-colors">
          &larr; All Industries
        </a>
        <span class="text-bone-dim/40 font-mono text-xs">/</span>
        <span class="font-mono text-xs uppercase tracking-wider text-ember">{data.name}</span>
      </div>

      <h1 class="font-display text-4xl font-semibold tracking-tight text-paper sm:text-5xl">
        {data.name}
      </h1>
      <p class="mt-3 font-mono text-xs uppercase tracking-wider text-ember">{data.tagline}</p>
      
      <div class="mt-8 rounded-xl border border-bone-dim/20 bg-ink-raised/60 p-6 shadow-lg">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-wider text-bone-dim flex items-center gap-1.5 mb-2">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
          The Operational Challenge
        </p>
        <p class="text-bone leading-relaxed text-sm sm:text-base">{data.painPoint}</p>
      </div>
    </div>
  </section>

  <!-- Key Capabilities Checklist -->
  <section class="border-b border-bone-dim/20 py-16 bg-ink-raised/20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="font-display text-2xl font-semibold text-paper mb-8">
        Why Salamandr fits {data.name}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {data.whyFit.map((point) => (
          <div class="flex items-start gap-3 rounded-lg border border-bone-dim/15 bg-ink/70 p-4">
            <span class="mt-1 flex h-4 w-4 flex-none items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 font-mono text-[10px]">
              ✓
            </span>
            <span class="text-sm text-bone leading-relaxed">{point}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deep Architectural Article Content -->
  <section class="py-16">
    <article class="mx-auto max-w-4xl px-6">
      <div class="prose prose-invert max-w-none font-sans prose-headings:font-display prose-headings:font-semibold prose-headings:text-paper prose-headings:tracking-tight prose-h2:text-2xl prose-h2:border-b prose-h2:border-bone-dim/20 prose-h2:pb-3 prose-h2:mt-12 prose-p:text-bone prose-p:leading-relaxed prose-a:text-ember prose-strong:text-paper prose-ul:text-bone">
        <Content />
      </div>

      <!-- Quickstart CTA Box -->
      <div class="mt-16 flex flex-col items-center gap-6 rounded-2xl border border-bone-dim/25 bg-ink-raised/60 p-8 sm:p-10 text-center sm:flex-row sm:justify-between sm:text-left shadow-lg">
        <div>
          <h2 class="font-display text-xl font-semibold text-paper">Ready to deploy on your own servers?</h2>
          <p class="mt-1 text-sm text-bone">One command via Docker Compose. Free forever up to 5 agents.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
          <a
            href={SITE.quickstartUrl}
            class="inline-flex items-center justify-center rounded-lg border border-ember bg-ember px-6 py-3 font-mono text-xs font-semibold uppercase tracking-wider text-ink shadow-[0_0_20px_rgba(232,137,11,0.25)] transition-all hover:bg-ember/90 hover:-translate-y-0.5"
          >
            Deploy in 5 min
          </a>
          <a
            href={SITE.industriesUrl}
            class="inline-flex items-center justify-center rounded-lg border border-bone-dim/40 bg-ink/70 px-5 py-3 font-mono text-xs font-medium uppercase tracking-wider text-bone transition-all hover:border-ember hover:text-paper"
          >
            All industries &rarr;
          </a>
        </div>
      </div>
    </article>
  </section>
</MarketingLayout>
